  "audio_text": {
   "vo_pair_o": "यह है ओ। इसकी मात्रा देखिए।",
   "vo_pair_au": "यह है औ। इसकी मात्रा देखिए।",
   "vo_t1_prompt": "आज हम ओ और औ की मात्रा वाले शब्द पढ़ेंगे।",
   "vo_matra_o": "ओ की मात्रा",
   "vo_matra_au": "औ की मात्रा",
   "vo_t2_prompt": "आइए, देखें कि ओ की मात्रा लगने से शब्द की आवाज़ कैसे बदलती है।",
   "vo_base_ghada": "यह शब्द देखिए, घड़ा।",
   "vo_onset_ghoda": "घ के साथ ओ की मात्रा लगाने पर, घो बनता है।",
   "vo_result_ghoda": "अब ड़ा जुड़ने पर, घोड़ा बनता है।",
   "vo_sounds_ghoda": "घ। घो। घोड़ा।",
   "vo_meet_mor": "मोर, बोलकर देखिए। इसमें म पर ओ की मात्रा लगी है।",
   "vo_meet_koyal": "कोयल, बोलकर देखिए। इसमें क पर ओ की मात्रा लगी है।",
   "vo_t3_prompt": "आइए, ओ की मात्रा वाले कुछ शब्द देखें।",
   "vo_t4_prompt": "आइए, देखें कि औ की मात्रा लगने से शब्द की आवाज़ कैसे बदलती है।",
   "vo_base_khilna": "यह शब्द देखिए, खिलना।",
   "vo_onset_khilona": "ल के साथ औ की मात्रा लगाने पर, लौ बनता है।",
   "vo_result_khilona": "अब खि, लौ और ना को जोड़ने पर, खिलौना बनता है।",
   "vo_sounds_khilona": "ल। लौ। खिलौना।",
   "vo_meet_kaua": "कौआ, बोलकर देखिए। इसमें क पर औ की मात्रा लगी है।",
   "vo_meet_paudha": "पौधा, बोलकर देखिए। इसमें प पर औ की मात्रा लगी है।",
   "vo_t5_prompt": "आइए, औ की मात्रा वाले कुछ शब्द देखें।",
   "vo_tap_prompt_o": "जिस डिब्बे में ओ की मात्रा वाला शब्द है, उस डिब्बे पर टैप कीजिए।",
   "vo_tap_h1_o": "फिर से पढ़िए। जिस शब्द में ओ की मात्रा आ रही है, उस पर टैप कीजिए।",
   "vo_tap_h2_o": "जिस शब्द में ओ की मात्रा है, उस पर टैप कीजिए।",
   "vo_g1_h3": "देखिए, मोर में ओ की मात्रा है। मोर पर टैप कीजिए।",
   "vo_g1_correct": "शाबाश! मोर शब्द में ओ की मात्रा है।",
   "vo_name_mor": "मोर",
   "vo_name_daud": "दौड़",
   "vo_name_chauk": "चौक",
   "vo_tap_prompt_au": "जिस डिब्बे में औ की मात्रा वाला शब्द है, उस डिब्बे पर टैप कीजिए।",
   "vo_tap_h1_au": "फिर से पढ़िए। जिस शब्द में औ की मात्रा आ रही है, उस पर टैप कीजिए।",
   "vo_tap_h2_au": "जिस शब्द में औ की मात्रा है, उस पर टैप कीजिए।",
   "vo_g2_h3": "देखिए, कौआ में औ की मात्रा है। कौआ पर टैप कीजिए।",
   "vo_g2_correct": "शाबाश! कौआ शब्द में औ की मात्रा है।",
   "vo_name_dhol": "ढोल",
   "vo_name_kaua": "कौआ",
   "vo_name_gol": "गोल",
   "vo_g3_h3": "देखिए, तोता में ओ की मात्रा है। तोता पर टैप कीजिए।",
   "vo_g3_correct": "शाबाश! तोता शब्द में ओ की मात्रा है।",
   "vo_name_nauka": "नौका",
   "vo_name_tota": "तोता",
   "vo_g4d_prompt": "देखिए, शब्द को उसकी मात्रा वाले डिब्बे में कैसे डालते हैं।",
