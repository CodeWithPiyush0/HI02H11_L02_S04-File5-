{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/3_BUILD/HI02H11_L02_S04.html" },
    { "source": "/index.html", "destination": "/3_BUILD/HI02H11_L02_S04.html" },
    { "source": "/HI02H11_L02_S04.html", "destination": "/3_BUILD/HI02H11_L02_S04.html" },
    { "source": "/favicon.ico", "destination": "/3_BUILD/assets/UI/favicon.ico" },
    { "source": "/assets/:path*", "destination": "/3_BUILD/assets/:path*" },
    { "source": "/card.json", "destination": "/3_BUILD/card.json" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
